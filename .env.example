# Supabase environment variables (Required for cloud persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # Server-side only (Optional)

# Application environment
APP_ENV=local

# Original optional configs
OPENAI_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here
DEBUG_MODE=False
PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# DeepSeek AI Marketing Copilot — Multi-Key Rotation
# ─────────────────────────────────────────────────────────────────────────────
# The copilot automatically rotates between keys when one hits its quota.
# When all keys are exhausted it shows a clear message instead of crashing.
#
# OPTION A: Numbered keys (recommended — add as many as you have)
# DEEPSEEK_API_KEY_1=sk-your-first-key-here
# DEEPSEEK_API_KEY_2=sk-your-second-key-here
# DEEPSEEK_API_KEY_3=sk-your-third-key-here
#
# OPTION B: Comma-separated list
# DEEPSEEK_API_KEYS=sk-key-one,sk-key-two,sk-key-three
#
# OPTION C: Legacy single key (backward compatible — still works)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API endpoint (optional — defaults to https://api.deepseek.com/v1)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# For Streamlit Cloud: add keys in the Secrets editor (Settings → Secrets)
# ─────────────────────────────────────────────────────────────────────────────
# DEEPSEEK_API_KEY_1 = "sk-..."
# DEEPSEEK_API_KEY_2 = "sk-..."
# DEEPSEEK_API_KEY_3 = "sk-..."
#
# Or as a TOML array in a [deepseek_keys] section:
# [deepseek_keys]          ← not supported by Streamlit flat secrets; use numbered keys
