# Supabase environment variables (Required for cloud persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # Server-side only (Optional)

# Application environment
APP_ENV=local

# Original optional configs
OPENAI_API_KEY=your_api_key_here
ANTHROPIC_API_KEY=your_api_key_here
DEBUG_MODE=False
PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# Gemini AI Marketing Copilot — Multi-Key Rotation
# ─────────────────────────────────────────────────────────────────────────────
# The copilot uses Google Gemini API with automatic key rotation.
# When one key hits its daily quota the next key is tried transparently.
#
# OPTION A: Numbered keys (recommended — add as many as you have)
# GEMINI_API_KEY_1=AIzaSy...
# GEMINI_API_KEY_2=AIzaSy...
# GEMINI_API_KEY_3=AIzaSy...
#
# OPTION B: Comma-separated list
# GEMINI_API_KEYS=AIzaSy-key-one,AIzaSy-key-two
#
# OPTION C: Legacy single key (backward compatible)
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use (optional — defaults to gemini-1.5-flash, generous free tier)
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_MODEL=gemini-1.5-pro

# ─────────────────────────────────────────────────────────────────────────────
# Streamlit Cloud: add in Settings → Secrets editor
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY_1 = "AIzaSy..."
# GEMINI_API_KEY_2 = "AIzaSy..."
# GEMINI_API_KEY_3 = "AIzaSy..."
