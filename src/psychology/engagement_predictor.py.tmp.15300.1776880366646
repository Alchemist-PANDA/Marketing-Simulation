import numpy as np
from src.agents.base_agent import Personality

class EngagementPredictor:
    def __init__(self):
        # Heuristic mapping of personality to engagement drivers
        self.personality_weights = {
            'openness': 0.3,      # novelty-seeking
            'extraversion': 0.4,  # social sharing
            'neuroticism': -0.2,   # anxiety reduces sharing
            'agreeableness': 0.2, # prone to liking
            'conscientiousness': 0.1 # deliberate action
        }

    def predict_like_probability(self, personality: Personality, ad: 'Ad') -> float:
        """
        Calculates probability of an agent 'liking' an ad.
        """
        # Incorporate ad scores directly into the probability calculation
        base = 0.1 # Lowered baseline

        # Personal trait modifiers
        base += personality.extraversion * 0.2
        base += personality.openness * 0.1
        base -= personality.neuroticism * 0.05

        # Ad score modifiers (Crucial for sensitivity)
        base += ad.price_score * 0.2
        base += ad.trust_score * 0.2
        base += ad.urgency_score * 0.1

        # Channel modifiers
        if ad.channel in ['tiktok', 'instagram']:
            base *= 1.5

        return np.clip(base, 0, 1)

    def predict_share_probability(self, personality: Personality, ad: 'Ad') -> float:
        """
        Calculates probability of an agent 'sharing' an ad.
        """
        # Extraversion is the primary driver of social spread
        share_base = 0.05 + 0.5 * personality.extraversion

        # Agreeableness also helps (positive reinforcement)
        share_base += 0.1 * personality.agreeableness

        return np.clip(share_base, 0, 1)
